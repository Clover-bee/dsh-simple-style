{
  "name": "@local/appearance-styles",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sidebar entry that switches the whole app's visual style: Bilibili Pink, Deep Ocean, Forest, Twilight, and Mono, each with light and dark palettes.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
